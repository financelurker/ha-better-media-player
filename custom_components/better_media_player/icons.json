{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:television-speaker",
        "state": {
          "off": "mdi:power-off",
          "starting": "mdi:timer-sand",
          "on": "mdi:power",
          "playing": "mdi:play",
          "run_down": "mdi:timer-outline",
          "stopping": "mdi:power-sleep",
          "manual": "mdi:hand-back-right",
          "error": "mdi:alert-circle",
          "disabled": "mdi:power-plug-off",
          "kept_on": "mdi:power-plug"
        }
      },
      "follow_state": {
        "default": "mdi:account-music",
        "state": {
          "inactive": "mdi:account-off-outline",
          "following": "mdi:account-music",
          "waiting": "mdi:account-clock",
          "override": "mdi:account-lock",
          "excluded_quiet": "mdi:account-cancel",
          "excluded_video": "mdi:account-cancel",
          "excluded_off": "mdi:account-cancel",
          "excluded_busy": "mdi:account-cancel",
          "presence_unknown": "mdi:account-question",
          "waking": "mdi:alarm",
          "snoozed": "mdi:alarm-snooze",
          "held_out": "mdi:account-clock-outline"
        }
      },
      "follow": {
        "default": "mdi:account-music",
        "range": {
          "0": "mdi:account-music-outline",
          "1": "mdi:account-music"
        }
      },
      "sleep_timer_end": {
        "default": "mdi:sleep"
      },
      "wake": {
        "default": "mdi:alarm",
        "state": {
          "idle": "mdi:alarm-off",
          "starting": "mdi:alarm",
          "fading": "mdi:alarm",
          "playing": "mdi:alarm-check",
          "snoozed": "mdi:alarm-snooze"
        }
      },
      "device_off_at": {
        "default": "mdi:timer-sand"
      },
      "video_host_off_at": {
        "default": "mdi:timer-sand"
      },
      "audio_host_off_at": {
        "default": "mdi:timer-sand"
      },
      "video_host_named_off_at": {
        "default": "mdi:timer-sand"
      },
      "audio_host_named_off_at": {
        "default": "mdi:timer-sand"
      },
      "display_off_at": {
        "default": "mdi:timer-sand"
      },
      "receiver_off_at": {
        "default": "mdi:timer-sand"
      },
      "amp_off_at": {
        "default": "mdi:timer-sand"
      },
      "speakers_off_at": {
        "default": "mdi:timer-sand"
      },
      "subwoofer_off_at": {
        "default": "mdi:timer-sand"
      },
      "switch_off_at": {
        "default": "mdi:timer-sand"
      },
      "mixer_off_at": {
        "default": "mdi:timer-sand"
      },
      "splitter_off_at": {
        "default": "mdi:timer-sand"
      }
    },
    "binary_sensor": {
      "display_demand": {
        "default": "mdi:television",
        "state": {
          "on": "mdi:television",
          "off": "mdi:television-off"
        }
      },
      "audio_demand": {
        "default": "mdi:speaker",
        "state": {
          "on": "mdi:speaker",
          "off": "mdi:speaker-off"
        }
      }
    },
    "switch": {
      "auto_power": {
        "default": "mdi:auto-mode",
        "state": {
          "on": "mdi:auto-mode",
          "off": "mdi:hand-back-right-off"
        }
      },
      "quiet": {
        "default": "mdi:volume-off",
        "state": {
          "on": "mdi:volume-off",
          "off": "mdi:volume-high"
        }
      },
      "night_mode": {
        "default": "mdi:weather-night",
        "state": {
          "on": "mdi:weather-night",
          "off": "mdi:weather-sunny"
        }
      },
      "follow_me": {
        "default": "mdi:account-music-outline",
        "state": {
          "on": "mdi:account-music",
          "off": "mdi:account-music-outline"
        }
      },
      "keep_on": {
        "default": "mdi:power-plug-outline",
        "state": {
          "on": "mdi:power-plug",
          "off": "mdi:power-plug-outline"
        }
      }
    },
    "number": {
      "sleep_timer": {
        "default": "mdi:sleep",
        "range": {
          "0": "mdi:sleep-off",
          "1": "mdi:sleep"
        }
      }
    },
    "button": {
      "all_off": {
        "default": "mdi:power"
      },
      "sleep_plus_15": {
        "default": "mdi:timer-plus-outline"
      },
      "wake_snooze": {
        "default": "mdi:alarm-snooze"
      },
      "wake_stop": {
        "default": "mdi:alarm-off"
      }
    },
    "select": {
      "volume_preset": {
        "default": "mdi:volume-equal",
        "state": {
          "quiet": "mdi:volume-low",
          "normal": "mdi:volume-medium",
          "loud": "mdi:volume-high",
          "party": "mdi:party-popper",
          "manual": "mdi:volume-equal"
        }
      },
      "handover": {
        "default": "mdi:transfer-right"
      }
    }
  },
  "services": {
    "set_sleep_timer": {
      "service": "mdi:sleep"
    },
    "cancel_sleep_timer": {
      "service": "mdi:sleep-off"
    },
    "wake": {
      "service": "mdi:alarm"
    },
    "snooze": {
      "service": "mdi:alarm-snooze"
    },
    "stop_wake": {
      "service": "mdi:alarm-off"
    },
    "start_follow": {
      "service": "mdi:account-music"
    },
    "stop_follow": {
      "service": "mdi:account-music-outline"
    },
    "set_volume_preset": {
      "service": "mdi:volume-equal"
    },
    "handover": {
      "service": "mdi:transfer-right"
    },
    "announce": {
      "service": "mdi:bullhorn"
    },
    "set_setting": {
      "service": "mdi:tune"
    },
    "get_settings": {
      "service": "mdi:tune-variant"
    }
  }
}
